<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=System.Runtime">

    <s:String x:Key="AppTitle">Hakaru — Disk Speed Benchmark</s:String>
    <s:String x:Key="Language">Language</s:String>
    <s:String x:Key="Drive">Drive</s:String>
    <s:String x:Key="Refresh">Refresh</s:String>
    <s:String x:Key="DriveInfoFmt">{0} total · {1} free</s:String>

    <s:String x:Key="TabBenchmark">Speed test</s:String>
    <s:String x:Key="TabCapacity">Capacity check</s:String>

    <!-- Speed test -->
    <s:String x:Key="BenchSize">Test size</s:String>
    <s:String x:Key="BenchStart">Start</s:String>
    <s:String x:Key="BenchStop">Stop</s:String>
    <s:String x:Key="BenchSeqRead">Sequential read (1 MiB)</s:String>
    <s:String x:Key="BenchSeqWrite">Sequential write (1 MiB)</s:String>
    <s:String x:Key="BenchRandRead">Random read (4 KiB, Q1)</s:String>
    <s:String x:Key="BenchRandWrite">Random write (4 KiB, Q1)</s:String>
    <s:String x:Key="BenchIdle">Ready. Pick a drive and press Start.</s:String>
    <s:String x:Key="BenchRunningFmt">{0}…  {1}</s:String>
    <s:String x:Key="BenchDoneFmt">Done. Test file: {0}</s:String>
    <s:String x:Key="BenchCanceled">Stopped.</s:String>

    <!-- Capacity check -->
    <s:String x:Key="CapModeFull">Test all free space</s:String>
    <s:String x:Key="CapModeQuick">Quick test only</s:String>
    <s:String x:Key="CapQuickSize">Quick test size</s:String>
    <s:String x:Key="CapKeepFiles">Keep test files after the check</s:String>
    <s:String x:Key="CapStart">Start capacity check</s:String>
    <s:String x:Key="CapStop">Stop</s:String>
    <s:String x:Key="CapWarnTitle">Before you start</s:String>
    <s:String x:Key="CapWarn">This fills the drive's free space with test data, then reads it back to verify. Your existing files are never touched. Do not remove the drive until it finishes.</s:String>
    <s:String x:Key="CapPhasePreparing">Preparing…</s:String>
    <s:String x:Key="CapPhaseWriting">Writing test data</s:String>
    <s:String x:Key="CapPhaseVerifying">Reading back and verifying</s:String>
    <s:String x:Key="CapPhaseCleaning">Deleting test files</s:String>
    <s:String x:Key="CapProgressFmt">{0} — {1} / {2}  ·  {3}  ·  ETA {4}</s:String>
    <s:String x:Key="CapResultGenuineFmt">No problem found. {0} written and verified. Write {1}, read {2}.</s:String>
    <s:String x:Key="CapResultSuspiciousTitle">⚠ Likely fake capacity</s:String>
    <s:String x:Key="CapResultSuspiciousFmt">Verified OK up to {0}. A problem starts at {1}. Real usable capacity is about {0}.</s:String>
    <s:String x:Key="CapReasonAliased">The drive's address wrapped around — it reuses the same physical memory for higher offsets.</s:String>
    <s:String x:Key="CapReasonCorrupt">Data read back did not match what was written.</s:String>
    <s:String x:Key="CapResultErrorFmt">Could not run the check: {0}</s:String>
    <s:String x:Key="CapResultCanceledFmt">Stopped. {0} written, {1} verified so far.</s:String>
    <s:String x:Key="CapNoFreeSpace">Not enough free space on this drive to run the check.</s:String>

    <!-- Shared -->
    <s:String x:Key="WriteLabel">Write</s:String>
    <s:String x:Key="ReadLabel">Read</s:String>
    <s:String x:Key="ResultTitle">Result</s:String>
    <s:String x:Key="LeftoverFound">Leftover Hakaru test files were found on this drive.</s:String>
    <s:String x:Key="CleanNow">Delete them</s:String>
    <s:String x:Key="Cleaned">Test files deleted.</s:String>
    <s:String x:Key="OpenFolderBtn">Open drive</s:String>
    <s:String x:Key="SystemDriveWarnFmt">{0} looks like your Windows drive. This test is meant for USB sticks and SD cards. Continue anyway?</s:String>
    <s:String x:Key="ConfirmTitle">Confirm</s:String>
    <s:String x:Key="NoDrive">No drive selected.</s:String>

</ResourceDictionary>
