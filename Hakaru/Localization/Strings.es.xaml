<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=System.Runtime">

    <s:String x:Key="AppTitle">Hakaru — Prueba de velocidad de disco</s:String>
    <s:String x:Key="Language">Idioma</s:String>
    <s:String x:Key="Drive">Unidad</s:String>
    <s:String x:Key="Refresh">Actualizar</s:String>
    <s:String x:Key="DriveInfoFmt">{0} en total · {1} libres</s:String>

    <s:String x:Key="TabBenchmark">Velocidad</s:String>
    <s:String x:Key="TabCapacity">Comprobar capacidad</s:String>

    <s:String x:Key="BenchSize">Tamaño de prueba</s:String>
    <s:String x:Key="BenchStart">Iniciar</s:String>
    <s:String x:Key="BenchStop">Detener</s:String>
    <s:String x:Key="BenchSeqRead">Lectura secuencial (1 MiB)</s:String>
    <s:String x:Key="BenchSeqWrite">Escritura secuencial (1 MiB)</s:String>
    <s:String x:Key="BenchRandRead">Lectura aleatoria (4 KiB, Q1)</s:String>
    <s:String x:Key="BenchRandWrite">Escritura aleatoria (4 KiB, Q1)</s:String>
    <s:String x:Key="BenchIdle">Listo. Elige una unidad y pulsa Iniciar.</s:String>
    <s:String x:Key="BenchRunningFmt">{0}…  {1}</s:String>
    <s:String x:Key="BenchDoneFmt">Terminado. Archivo de prueba: {0}</s:String>
    <s:String x:Key="BenchCanceled">Detenido.</s:String>

    <s:String x:Key="CapModeFull">Probar todo el espacio libre</s:String>
    <s:String x:Key="CapModeQuick">Solo prueba rápida</s:String>
    <s:String x:Key="CapQuickSize">Tamaño de la prueba rápida</s:String>
    <s:String x:Key="CapKeepFiles">Conservar los archivos de prueba después</s:String>
    <s:String x:Key="CapStart">Iniciar comprobación de capacidad</s:String>
    <s:String x:Key="CapStop">Detener</s:String>
    <s:String x:Key="CapWarnTitle">Antes de empezar</s:String>
    <s:String x:Key="CapWarn">Esto llena el espacio libre de la unidad con datos de prueba y luego los vuelve a leer para verificarlos. Tus archivos existentes no se tocan. No extraigas la unidad hasta que termine.</s:String>
    <s:String x:Key="CapPhasePreparing">Preparando…</s:String>
    <s:String x:Key="CapPhaseWriting">Escribiendo datos de prueba</s:String>
    <s:String x:Key="CapPhaseVerifying">Releyendo y verificando</s:String>
    <s:String x:Key="CapPhaseCleaning">Eliminando archivos de prueba</s:String>
    <s:String x:Key="CapProgressFmt">{0} — {1} / {2}  ·  {3}  ·  faltan {4}</s:String>
    <s:String x:Key="CapResultGenuineFmt">No se han detectado problemas. {0} escritos y verificados. Escritura {1}, lectura {2}.</s:String>
    <s:String x:Key="CapResultSuspiciousTitle">⚠ Capacidad probablemente falsa</s:String>
    <s:String x:Key="CapResultSuspiciousFmt">Verificado correctamente hasta {0}. El problema empieza en {1}. La capacidad real utilizable es de unos {0}.</s:String>
    <s:String x:Key="CapReasonAliased">La dirección de la unidad se reinicia: reutiliza la misma memoria física para los desplazamientos mayores.</s:String>
    <s:String x:Key="CapReasonCorrupt">Los datos releídos no coinciden con los que se escribieron.</s:String>
    <s:String x:Key="CapResultErrorFmt">No se pudo ejecutar la comprobación: {0}</s:String>
    <s:String x:Key="CapResultCanceledFmt">Detenido. Hasta ahora {0} escritos y {1} verificados.</s:String>
    <s:String x:Key="CapNoFreeSpace">No hay suficiente espacio libre en esta unidad para la comprobación.</s:String>

    <s:String x:Key="WriteLabel">Escritura</s:String>
    <s:String x:Key="ReadLabel">Lectura</s:String>
    <s:String x:Key="ResultTitle">Resultado</s:String>
    <s:String x:Key="LeftoverFound">Se han encontrado archivos de prueba de Hakaru en esta unidad.</s:String>
    <s:String x:Key="CleanNow">Eliminarlos</s:String>
    <s:String x:Key="Cleaned">Archivos de prueba eliminados.</s:String>
    <s:String x:Key="OpenFolderBtn">Abrir unidad</s:String>
    <s:String x:Key="SystemDriveBlockedFmt">{0} es la unidad donde está instalado Windows. Para proteger el sistema operativo, no se puede probar esta unidad.</s:String>
    <s:String x:Key="NoDrive">No hay ninguna unidad seleccionada.</s:String>

</ResourceDictionary>
