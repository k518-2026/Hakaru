<Window x:Class="Hakaru.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hakaru.ViewModels"
        Title="{DynamicResource AppTitle}"
        Height="600" Width="960" MinHeight="520" MinWidth="820"
        Background="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <!-- 1 行に全部並べると最小幅（820）でドライブ欄と「再読み込み」が切れるため 2 行に分ける -->
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Language}" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox MinWidth="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- ドライブ欄は 460 まで広がり、余りは右の空き列へ回す -->
                        <ColumnDefinition Width="*" MinWidth="200" MaxWidth="460" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="0.001*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Drive}" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" IsEnabled="{Binding NotBusy}"
                              ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" />
                    <Button Grid.Column="2" Content="{DynamicResource Refresh}" Command="{Binding RefreshDrivesCommand}"
                            IsEnabled="{Binding NotBusy}" Margin="8,0,0,0" MinWidth="0" Padding="12,6" />
                    <TextBlock Grid.Column="4" Text="{Binding DriveInfoText}" Style="{StaticResource Mono}"
                               FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Grid>
        </Border>

        <!-- 残置ファイルの通知 -->
        <Border Grid.Row="1" Background="#33E8A33D" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1"
                Padding="16,8" Visibility="{Binding LeftoverVisible, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource LeftoverFound}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="{DynamicResource CleanNow}" Command="{Binding CleanupCommand}" MinWidth="0" Padding="10,4" />
                <Button Content="{DynamicResource OpenFolderBtn}" Command="{Binding OpenDriveCommand}" MinWidth="0" Padding="10,4" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" Margin="0">
            <!-- ============ 速度テスト ============ -->
            <TabItem Header="{DynamicResource TabBenchmark}">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <TextBlock Text="{DynamicResource BenchSize}" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox MinWidth="120" IsEnabled="{Binding NotBusy}"
                                  ItemsSource="{Binding BenchSizes}" SelectedItem="{Binding SelectedBenchSize}" />
                        <Button Content="{DynamicResource BenchStart}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunBenchmarkCommand}" Margin="16,0,0,0"
                                Visibility="{Binding IsBenchRunning, Converter={StaticResource NotBoolVis}}" />
                        <Button Content="{DynamicResource BenchStop}" Style="{StaticResource DangerButton}"
                                Command="{Binding StopBenchmarkCommand}" Margin="16,0,0,0"
                                Visibility="{Binding IsBenchRunning, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Margin="0,16,0,0" Minimum="0" Maximum="1" Value="{Binding BenchProgress, Mode=OneWay}"
                                 Visibility="{Binding IsBenchRunning, Converter={StaticResource BoolVis}}" />

                    <TextBlock Grid.Row="2" Text="{Binding BenchStatusText}" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="3" Margin="0,24,0,0" MaxWidth="680" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource BenchSeqRead}" VerticalAlignment="Center" Margin="0,7" />
                        <Grid Grid.Row="0" Grid.Column="1" Height="16" VerticalAlignment="Center" Margin="8,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="3" />
                            <Border Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding SeqReadRatio, Converter={StaticResource RatioWidth}, ConverterParameter=284}" />
                        </Grid>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SeqReadText}" Style="{StaticResource Mono}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource BenchSeqWrite}" VerticalAlignment="Center" Margin="0,7" />
                        <Grid Grid.Row="1" Grid.Column="1" Height="16" VerticalAlignment="Center" Margin="8,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="3" />
                            <Border Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding SeqWriteRatio, Converter={StaticResource RatioWidth}, ConverterParameter=284}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SeqWriteText}" Style="{StaticResource Mono}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource BenchRandRead}" VerticalAlignment="Center" Margin="0,7" />
                        <Grid Grid.Row="2" Grid.Column="1" Height="16" VerticalAlignment="Center" Margin="8,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="3" />
                            <Border Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding RandReadRatio, Converter={StaticResource RatioWidth}, ConverterParameter=284}" />
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RandReadText}" Style="{StaticResource Mono}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource BenchRandWrite}" VerticalAlignment="Center" Margin="0,7" />
                        <Grid Grid.Row="3" Grid.Column="1" Height="16" VerticalAlignment="Center" Margin="8,0">
                            <Border Background="{StaticResource Surface}" CornerRadius="3" />
                            <Border Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding RandWriteRatio, Converter={StaticResource RatioWidth}, ConverterParameter=284}" />
                        </Grid>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RandWriteText}" Style="{StaticResource Mono}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ 容量チェック ============ -->
            <TabItem Header="{DynamicResource TabCapacity}">
                <Grid Margin="22,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton x:Name="FullModeRadio" GroupName="capmode" Content="{DynamicResource CapModeFull}"
                                     IsEnabled="{Binding NotBusy}"
                                     IsChecked="{Binding CapModeQuick, Converter={StaticResource NotBool}, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="capmode" Content="{DynamicResource CapModeQuick}"
                                         IsEnabled="{Binding NotBusy}" VerticalAlignment="Center"
                                         IsChecked="{Binding CapModeQuick}" />
                            <ComboBox MinWidth="110" Margin="12,0,0,0" IsEnabled="{Binding CapModeQuick}"
                                      ItemsSource="{Binding CapQuickSizes}" SelectedItem="{Binding SelectedCapQuickSize}" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource CapKeepFiles}" IsChecked="{Binding KeepTestFiles}"
                                  IsEnabled="{Binding NotBusy}" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,16,0,0">
                        <TextBlock Text="{DynamicResource CapWarn}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}" FontSize="12" />
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{DynamicResource CapStart}" Style="{StaticResource PrimaryButton}" MinWidth="0" Padding="16,7"
                                Command="{Binding RunCapacityCommand}"
                                Visibility="{Binding IsCapRunning, Converter={StaticResource NotBoolVis}}" />
                        <Button Content="{DynamicResource CapStop}" Style="{StaticResource DangerButton}" MinWidth="0" Padding="16,7"
                                Command="{Binding StopCapacityCommand}"
                                Visibility="{Binding IsCapRunning, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding CapProgress, Mode=OneWay}"
                                     Visibility="{Binding IsCapRunning, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding CapStatusText}" Foreground="{StaticResource Muted}" FontSize="12"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="4" Margin="0,18,0,0" VerticalAlignment="Top"
                            Background="{StaticResource Surface}" BorderThickness="1" CornerRadius="4" Padding="16,14"
                            Visibility="{Binding HasCapResult, Converter={StaticResource BoolVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CapResultIsWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding CapResultTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CapResultIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CapResultText}" TextWrapping="Wrap" Foreground="{StaticResource Text}"
                                       FontSize="12.5" LineHeight="19" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
